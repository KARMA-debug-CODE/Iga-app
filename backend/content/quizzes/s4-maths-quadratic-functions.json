    {"type": "mcq", "difficulty": 1, "prompt": "The graph of $y = -x^2 + 4x + 1$ opens…",
     "choices": [{"text": "upwards, with a minimum"}, {"text": "downwards, with a maximum", "correct": true}],
     "explanation": "$a = -1 < 0$, so the parabola opens downwards and has a maximum."},
