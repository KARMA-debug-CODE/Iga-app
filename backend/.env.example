# Copy to .env (or set in your hosting dashboard). All values are optional in development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_NAME=Iga

# PostgreSQL in production (SQLite is used when this is empty)
# DATABASE_URL=postgres://iga:password@localhost:5432/iga

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
EXAM_SUBMIT_GRACE_SECONDS=30
THROTTLE_AUTH=20/min
THROTTLE_CHAT=30/min
