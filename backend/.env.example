# Copy to .env (or set in your hosting dashboard). All values are optional in development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Encrypts 2FA secrets, phone numbers and payment details in the database. Required when DJANGO_DEBUG
# is off, and must be random (development derives one from DJANGO_SECRET_KEY). Comma-separated: the
# first encrypts, all decrypt (key rotation, then `manage.py rotate_field_encryption`). Generate one with
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# FIELD_ENCRYPTION_KEYS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_NAME=Iga

# PostgreSQL in production (SQLite is used when this is empty). Run the app as a role that may only read
# and write rows, and migrations as the role that owns the tables: `manage.py db_roles`, run once (and
# again after a password change) with a superuser in DATABASE_URL, creates both from these two URLs
# (docker compose does all of this itself):
#   DATABASE_URL=postgres://postgres:...@localhost:5432/iga \
#   DB_OWNER_URL=postgres://iga_owner:...@localhost:5432/iga \
#   DB_APP_URL=postgres://iga_app:...@localhost:5432/iga python manage.py db_roles
#   DATABASE_URL=$DB_OWNER_URL python manage.py migrate
# then serve with DATABASE_URL set to the app role's URL. On a real deployment, `migrate` refuses to run
# as a superuser (check iga.E004) and warns about CREATEDB, CREATEROLE, REPLICATION or BYPASSRLS (iga.W002).
# DATABASE_URL=postgres://iga_app:password@localhost:5432/iga
# DB_OWNER_URL=                        (only for db_roles)
# DB_APP_URL=                          (only for db_roles)

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
EXAM_SUBMIT_GRACE_SECONDS=30
THROTTLE_AUTH=300/min
THROTTLE_LOGIN=10/min
THROTTLE_REFRESH=600/min
# THROTTLE_REGISTER=100/hour          (new accounts per IP)
# THROTTLE_PASSWORD_RESET=5/hour      (reset emails per account)
# THROTTLE_PASSWORD_RESET_IP=30/hour  (reset requests per IP)
# THROTTLE_REFRESH_USER=60/min        (session refreshes per account)
# Progressive lockout after failed sign-ins: failures in a row for one account from one IP, for one
# account from anywhere, and from one IP for any account. The lock doubles each time that day.
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_ACCOUNT_THRESHOLD=20
# LOGIN_LOCKOUT_IP_THRESHOLD=100
# LOGIN_LOCKOUT_BASE_SECONDS=60
# LOGIN_LOCKOUT_MAX_SECONDS=3600
# LOGIN_FAILURE_WINDOW_SECONDS=900
# Security events (sign-ins, lockouts, password and 2FA changes, refused requests) are JSON lines on
# the "iga.security" logger, and in Admin -> Audit.
# SECURITY_LOG_LEVEL=INFO
# Password reset links (emailed; needs a real EMAIL_BACKEND) work once, for this many seconds.
# PASSWORD_RESET_TIMEOUT_SECONDS=3600
# A teacher's temporary password (class roster, reset) stops working after this many days.
# TEMPORARY_PASSWORD_DAYS=14
# "This email is already used" answers per hour, per IP (sign-up) or per account, before requests
# with an email address are refused for the rest of the hour (slows down email probing).
# EMAIL_IN_USE_LIMIT=10
# REDIS_URL=redis://localhost:6379/0   (shared rate limits across server processes)
THROTTLE_CHAT=30/min
THROTTLE_SENSITIVE=5/min
THROTTLE_JOIN=10/min

# Security. HTTPS defaults to on whenever DJANGO_DEBUG is off.
# HTTPS=true
# TRUSTED_PROXY_COUNT=1          (proxies that append to X-Forwarded-For)
# REFRESH_REUSE_GRACE_SECONDS=30
# REFRESH_COOKIE_SAMESITE=Strict   (the session cookie; Lax only if the app and API are on different sites)
# DJANGO_ADMIN_SESSION_HOURS=8     (Django admin sessions end after this)
# DJANGO_ADMIN_ENABLED=false     (defaults to DJANGO_DEBUG)
# DJANGO_ADMIN_PATH=             (with DEBUG off the admin needs it: a long random secret, at least 16 letters,
#                                 digits, - or _; the admin is then at /django-admin/<DJANGO_ADMIN_PATH>/)
# DJANGO_ADMIN_REQUIRE_2FA=false (development only: with DEBUG off, staff always need 2FA)
# ADMIN_LOGIN_ATTEMPTS_PER_MINUTE=10      (Django admin sign-in attempts per account)
# ADMIN_LOGIN_IP_ATTEMPTS_PER_MINUTE=30   (... and per address)
# STEP_UP_MAX_AGE_SECONDS=900    (privileged operations need the password confirmed this recently)
# Argon2id password hashing costs (Django's defaults; each login briefly uses this much memory).
# Changing them re-hashes each password at its owner's next login.
# ARGON2_TIME_COST=2
# ARGON2_MEMORY_COST_KIB=102400
# ARGON2_PARALLELISM=8

# Santa, Iga's own AI tutor: llama.cpp's llama-server with an open model on this machine (empty SANTA_URL
# = no model; Santa then answers from the lessons only). Start one locally with Docker, for example:
#   docker run -d --name santa -p 127.0.0.1:8081:8080 -v santa-models:/models -e LLAMA_CACHE=/models \
#     -e LLAMA_API_KEY=a-shared-secret ghcr.io/ggml-org/llama.cpp:server-b11151 \
#     -hf google/gemma-4-E2B-it-qat-q4_0-gguf:Q4_0 --no-mmproj -c 8192 -np 2 --reasoning off --alias santa
# SANTA_URL=http://127.0.0.1:8081
# SANTA_API_KEY=a-shared-secret
# SANTA_MODEL_NAME=santa              (llama-server --alias)
# SANTA_MAX_TOKENS=600                (longest answer, in tokens)
# SANTA_TEMPERATURE=0.6
# SANTA_TIMEOUT_SECONDS=150           (the most one answer may take, calculator rounds included)
# SANTA_PARALLEL=4                    (answers written at the same time: llama-server -np)
# THROTTLE_TUTOR=30/hour

# C++ and Java in the code playground: Iga's code runner (coderunner/), reachable only from Django (empty = off).
# Run it locally with: docker compose up coderunner (then CODE_RUNNER_URL=http://127.0.0.1:2000 needs a published port).
# CODE_RUNNER_URL=
# CODE_RUNNER_TOKEN=a-shared-secret
# THROTTLE_CODE_RUN=20/min
# THROTTLE_CODE_INPUT=120/min

# School subscriptions
# SUBSCRIPTION_PRICE_USD=200
# SUBSCRIPTION_PRICE_RWF=             (set to also accept mobile money in Rwandan francs)
# SUBSCRIPTION_GRACE_DAYS=3
# BILLING_PROVIDER=flutterwave        (empty: bank transfers recorded by platform admins only)
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=
# CHECKOUT_SESSION_MINUTES=60         (how long the payment page stays open; open payments are then closed)
# FLUTTERWAVE_MAX_RETRIES=5           (attempts allowed in one checkout)
# BILLING_DEV_MODE=true               (fake checkout; defaults to DJANGO_DEBUG; never in production)
# LEDGER_HMAC_KEY=                    (optional: signs the money ledger's hash chain; once set, keep it)
# FRONTEND_URL=http://localhost:5173
# PROTECTED_MEDIA_ACCEL=false         (true behind the bundled nginx)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
