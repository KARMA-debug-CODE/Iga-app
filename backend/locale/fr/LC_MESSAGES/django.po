msgid "This reference was already recorded on %(date)s for %(school)s."
msgstr "Cette référence a déjà été enregistrée le %(date)s pour %(school)s."

#: apps/schools/billing.py:244
msgid "Between 1 and 24 months."
msgstr "Entre 1 et 24 mois."

#: apps/schools/billing.py:247
msgid "The amount can't be negative."
msgstr "Le montant ne peut pas être négatif."

#: apps/schools/billing.py:249
msgid "Say how it was paid (bank reference, receipt number, or why it is free)."
msgstr "Indiquez comment le paiement a été fait (référence bancaire, numéro de reçu, ou raison de la gratuité)."

#: apps/schools/billing.py:318
msgid "Choose a refund or a correction."
msgstr "Choisissez un remboursement ou une correction."

#: apps/schools/billing.py:323
msgid "A refund is money paid back: enter it as a negative amount."
msgstr "Un remboursement est de l'argent rendu : saisissez-le comme un montant négatif."

#: apps/schools/billing.py:325
msgid "The fee must be between 0 and the amount."
msgstr "Les frais doivent être compris entre 0 et le montant."

#: apps/schools/billing.py:327
msgid "Between -24 and 24 months."
msgstr "Entre -24 et 24 mois."

#: apps/schools/billing.py:329
msgid "A correction must change an amount or a number of months."
msgstr "Une correction doit modifier un montant ou un nombre de mois."

#: apps/schools/billing.py:331
msgid "Say why (for example the refund reference or what was wrong)."
msgstr "Indiquez pourquoi (par exemple la référence du remboursement ou ce qui était erroné)."

#: apps/schools/billing.py:333
msgid "That entry belongs to another school."
msgstr "Cette écriture appartient à une autre école."

#: apps/schools/billing.py:69
msgid "Choose %(options)s months."
msgstr "Choisissez %(options)s mois."

#: apps/schools/billing.py:73
msgid "Choose one of these currencies: %(options)s."
msgstr "Choisissez l'une de ces devises : %(options)s."

#: apps/schools/billing.py:356
msgid "This school has no paid months to take back."
msgstr "Cette école n'a pas de mois payés à retirer."

#: apps/schools/downloads.py:40
msgid "This download link has expired. Go back and open the paper again."
msgstr "Ce lien de téléchargement a expiré. Revenez en arrière et ouvrez à nouveau l'épreuve."

#: apps/schools/flutterwave.py:57
msgid "The payment service isn't answering right now. Please try again in a few minutes."
msgstr "Le service de paiement ne répond pas pour le moment. Veuillez réessayer dans quelques minutes."

#: apps/schools/flutterwave.py:147
msgid "%(app)s school subscription"
msgstr "Abonnement scolaire %(app)s"

#: apps/schools/flutterwave.py:148
msgid "%(school)s: %(months)s month(s)"
msgstr "%(school)s : %(months)s mois"

#: apps/schools/membership.py:103
msgid "Only this school's administrators can do that."
msgstr "Seuls les administrateurs de cette école peuvent faire cela."

#: apps/schools/membership.py:32
msgid "Only students, teachers and school staff belong to a school."
msgstr "Seuls les élèves, les enseignants et le personnel d'une école en font partie."

#: apps/schools/membership.py:36
msgid "That school isn't verified yet."
msgstr "Cette école n'est pas encore vérifiée."

#: apps/schools/membership.py:41
msgid "That code doesn't match this school. Check it with your school, or leave it empty to ask for approval."
msgstr "Ce code ne correspond pas à cette école. Vérifiez-le auprès de votre école, ou laissez-le vide pour demander une approbation."

#: apps/schools/membership.py:168
msgid "That person isn't a member of this school."
msgstr "Cette personne n'est pas membre de cette école."

#: apps/schools/membership.py:170
msgid "You can't remove yourself."
msgstr "Vous ne pouvez pas vous retirer vous-même."

#: apps/schools/notify.py:57
msgid "%(app)s: payment received for %(school)s"
msgstr "%(app)s : paiement reçu pour %(school)s"

#: apps/schools/notify.py:96
msgid "Renew here: %(url)s"
msgstr "Renouveler ici : %(url)s"

#: apps/schools/notify.py:82
msgid "%(app)s: %(school)s's subscription ends in %(days)s day(s)"
msgstr "%(app)s : l'abonnement de %(school)s se termine dans %(days)s jour(s)"

#: apps/schools/notify.py:83
msgid "%(school)s's %(app)s subscription is paid until %(date)s."
msgstr "L'abonnement %(app)s de %(school)s est payé jusqu'au %(date)s."

#: apps/schools/notify.py:60
msgid "Thank you. We received %(amount)s for %(months)s month(s) of %(app)s for %(school)s."
msgstr "Merci. Nous avons reçu %(amount)s pour %(months)s mois de %(app)s pour %(school)s."

#: apps/schools/notify.py:63
msgid "Reference: %(reference)s"
msgstr "Référence : %(reference)s"

#: apps/schools/notify.py:64
msgid "Access paid until: %(date)s"
msgstr "Accès payé jusqu'au : %(date)s"

#: apps/schools/notify.py:66
msgid "All approved students and teachers of %(school)s have full access."
msgstr "Tous les élèves et enseignants approuvés de %(school)s ont un accès complet."

#: apps/schools/notify.py:67
msgid "Receipts: %(url)s"
msgstr "Reçus : %(url)s"

#: apps/schools/notify.py:85
msgid "%(app)s: %(school)s's subscription has ended"
msgstr "%(app)s : l'abonnement de %(school)s est terminé"

#: apps/schools/notify.py:86
msgid "%(school)s's %(app)s subscription ended on %(date)s. Students keep full access until %(grace)s; after that they will only see the free lessons."
msgstr "L'abonnement %(app)s de %(school)s s'est terminé le %(date)s. Les élèves gardent l'accès complet jusqu'au %(grace)s ; ensuite, ils ne verront plus que les leçons gratuites."

#: apps/schools/notify.py:91
msgid "%(app)s: %(school)s's students no longer have full access"
msgstr "%(app)s : les élèves de %(school)s n'ont plus l'accès complet"

#: apps/schools/notify.py:92
msgid "%(school)s's %(app)s subscription ended on %(date)s. Students now only see the free lessons until the school renews."
msgstr "L'abonnement %(app)s de %(school)s s'est terminé le %(date)s. Les élèves ne voient plus que les leçons gratuites jusqu'au renouvellement."

#: apps/schools/providers.py:79
msgid "Unknown payment provider."
msgstr "Prestataire de paiement inconnu."

#: apps/schools/serializers.py:206
msgid "Another school in this district already has this name."
msgstr "Une autre école de ce district porte déjà ce nom."

#: apps/schools/views.py:252
msgid "This payment belongs to another school."
msgstr "Ce paiement appartient à une autre école."

#: apps/schools/views.py:235
msgid "Online payment isn't set up yet. Please pay by bank transfer and contact the Iga team."
msgstr "Le paiement en ligne n'est pas encore disponible. Veuillez payer par virement bancaire et contacter l'équipe Iga."

#: apps/schools/views.py:292
msgid "Test payments are switched off."
msgstr "Les paiements de test sont désactivés."

#: apps/schools/views.py:295
msgid "This payment can't be completed here."
msgstr "Ce paiement ne peut pas être finalisé ici."

#: apps/schools/views.py:451
msgid "Send a key of 8 to 80 letters, digits, - or _."
msgstr "Envoyez une clé de 8 à 80 caractères : lettres, chiffres, - ou _."

#: apps/schools/views.py:124
msgid "School administrators change school through the Iga team."
msgstr "Les administrateurs d'école changent d'école en passant par l'équipe Iga."

#: apps/schools/views.py:133
msgid "School administrators leave a school through the Iga team."
msgstr "Les administrateurs d'école quittent une école en passant par l'équipe Iga."

#: apps/schools/views.py:609
msgid "Enter a date as YYYY-MM-DD."
msgstr "Saisissez une date au format AAAA-MM-JJ."

#: apps/schools/views.py:515
msgid "No ledger entry has that number."
msgstr "Aucune écriture du registre ne porte ce numéro."

#: apps/schools/views.py:442
msgid "Unknown action."
msgstr "Action inconnue."

#: apps/schools/views.py:437
msgid "Only a school waiting for verification, with no payments, can be rejected."
msgstr "Seule une école en attente de vérification, sans aucun paiement, peut être refusée."

#: apps/simulations/models.py:61
msgid "An external simulation needs a full https:// address."
msgstr "Une simulation externe a besoin d'une adresse complète en https://."

#: apps/simulations/views.py:57
#: apps/simulations/views.py:69
msgid "Not found."
msgstr "Introuvable."

#: apps/tutor/services.py:525
msgid "Santa can't answer just now. Try again in a minute."
msgstr "Santa ne peut pas répondre pour le moment. Réessayez dans une minute."

#: apps/tutor/services.py:317
msgid "Santa is switched off while you have an exam or timed test open (“%(quiz)s”). Submit it to use Santa again."
msgstr "Santa est désactivé tant que vous avez un examen ou un test chronométré ouvert (« %(quiz)s »). Rendez-le pour utiliser à nouveau Santa."

#: apps/tutor/services.py:518
msgid "Santa's AI model is not installed on this school's server yet."
msgstr "Le modèle d'IA de Santa n'est pas encore installé sur le serveur de cette école."

#: apps/tutor/services.py:520
msgid "Santa is still waking up. Ask again in a minute for a full answer."
msgstr "Santa se réveille encore. Reposez votre question dans une minute pour avoir une réponse complète."

#: apps/tutor/services.py:522
msgid "Santa is helping many students right now. Ask again in a minute for a full answer."
msgstr "Santa aide beaucoup d'élèves en ce moment. Reposez votre question dans une minute pour avoir une réponse complète."

#: apps/tutor/services.py:524
msgid "This is too long for Santa. Ask a shorter question, or start a new chat."
msgstr "C'est trop long pour Santa. Posez une question plus courte, ou commencez une nouvelle discussion."

#: apps/tutor/services.py:548
msgid "If you feel unsafe or someone is hurting you, please talk to a trusted adult or a teacher today. In Rwanda you can call the free child helpline 116."
msgstr "Si vous ne vous sentez pas en sécurité ou si quelqu'un vous fait du mal, parlez dès aujourd'hui à un adulte de confiance ou à un enseignant. Au Rwanda, vous pouvez appeler gratuitement la ligne d'aide à l'enfance 116."

#: apps/tutor/services.py:100
msgid "Must be a list of messages."
msgstr "Doit être une liste de messages."

#: apps/tutor/services.py:115
msgid "The history must end with a reply from Santa."
msgstr "L'historique doit se terminer par une réponse de Santa."

#: apps/tutor/services.py:213
msgid "Unknown subject."
msgstr "Matière inconnue."

#: apps/tutor/services.py:235
msgid "Attempt not found."
msgstr "Tentative introuvable."

#: apps/tutor/services.py:240
msgid "Santa is switched off during exams and timed tests. Good luck!"
msgstr "Santa est désactivé pendant les examens et les tests chronométrés. Bonne chance !"

#: apps/tutor/services.py:310
msgid "Write a question for Santa."
msgstr "Écrivez une question pour Santa."

#: apps/tutor/services.py:533
msgid "I couldn't find this in your lessons. Try other words, open the lesson on this topic, or ask your teacher."
msgstr "Je n'ai pas trouvé cela dans vos leçons. Essayez d'autres mots, ouvrez la leçon sur ce sujet ou demandez à votre enseignant."

#: apps/tutor/services.py:536
msgid "Here is what your lessons say:"
msgstr "Voici ce que disent vos leçons :"

#: apps/tutor/services.py:598
msgid "Santa is still answering your last question. Wait for it to finish, or stop it."
msgstr "Santa répond encore à votre dernière question. Attendez la fin de la réponse ou arrêtez-la."

#: apps/tutor/services.py:112
msgid "Messages must alternate between the student and Santa."
msgstr "Les messages doivent alterner entre l'élève et Santa."

#: apps/tutor/services.py:312
msgid "Please keep questions under %(n)s characters."
msgstr "Veuillez limiter vos questions à %(n)s caractères."

#: apps/tutor/services.py:650
msgid "I can't help with that one. Ask about your lessons or a practice question, or ask your teacher."
msgstr "Je ne peux pas vous aider sur ce point. Posez une question sur vos leçons ou sur un exercice, ou demandez à votre enseignant."

#: apps/tutor/services.py:647
msgid "(Santa ran out of space. Ask me to continue.)"
msgstr "(Santa n'a plus de place. Demandez-moi de continuer.)"

#: apps/tutor/services.py:635
msgid "(Santa stopped before finishing. Ask again, or check your lessons.)"
msgstr "(Santa s'est arrêté avant la fin. Reposez la question ou consultez vos leçons.)"
