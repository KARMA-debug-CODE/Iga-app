# Settings for `docker compose`. Copy to .env next to docker-compose.yml.
#
# Required: a long random secret. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Local trial over plain http://localhost:8080. Delete this line for a real
# deployment behind HTTPS (secure cookies, HSTS and HTTPS redirects switch on).
HTTPS=false

POSTGRES_PASSWORD=iga-local-only
# DJANGO_ALLOWED_HOSTS=iga.example.rw
# CSRF_TRUSTED_ORIGINS=https://iga.example.rw

# Number of proxies that append to X-Forwarded-For: 1 for the bundled nginx,
# 2 if a load balancer sits in front of it as well.
# TRUSTED_PROXY_COUNT=1

# Content managers' Django admin at /django-admin/ (staff need 2FA to sign in).
# DJANGO_ADMIN_ENABLED=true

# AI tutor and the "Ask AI" page (Claude API): leave empty to keep them off.
# ANTHROPIC_API_KEY=

# C++ and Java in the code playground run on the bundled Piston code runner. Uncomment (empty value)
# to switch them off; in production, point it at a code runner on its own machine.
# CODE_RUNNER_URL=

# --- School subscriptions -------------------------------------------------
# Price per school per month. MTN MoMo and Airtel Money only work in francs, so set an RWF price
# (whole francs) to offer them; with USD only, schools can pay by card.
# SUBSCRIPTION_PRICE_USD=200
# SUBSCRIPTION_PRICE_RWF=280000
# Online payments through Flutterwave (cards, MTN MoMo and Airtel Money in Rwanda).
# Without it, the Iga team records bank transfers in Admin → Schools.
# BILLING_PROVIDER=flutterwave
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_WEBHOOK_HASH=a-long-random-string   (same value as in the Flutterwave dashboard)
# Webhook URL to set in the Flutterwave dashboard: https://<your-domain>/api/billing/webhooks/flutterwave/
# and tick: JSON format, v3 webhooks, webhook retries, resend from the dashboard (docs/SUBSCRIPTIONS.md).
# CHECKOUT_SESSION_MINUTES=60                  (how long Flutterwave's payment page stays open)
# FRONTEND_URL=https://iga.example.rw          (where Flutterwave sends people back after paying)
# A fake checkout for demos only. Never enable it on a real server.
# BILLING_DEV_MODE=true

# --- Email (receipts and subscription reminders) ---------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=Iga <no-reply@iga.rw>
