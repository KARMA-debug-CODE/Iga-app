# Settings for `docker compose`. Copy to .env next to docker-compose.yml.
#
# Required: a long random secret. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required: the random key that encrypts 2FA secrets, phone numbers and payment details in the
# database. Generate one with
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe apart from database backups: without it those values can't be read.
# To rotate: put a new key first and the old one after a comma, restart, run
#   docker compose exec backend python manage.py rotate_field_encryption
# then remove the old key.
FIELD_ENCRYPTION_KEYS=

# Local trial over plain http://localhost:8080. Delete this line for a real
# deployment behind HTTPS (secure cookies, HSTS and HTTPS redirects switch on, in nginx and Django).
# HTTPS itself: a load balancer or Cloudflare in front (docs/CLOUDFLARE.md), or nginx with your certificate
# (frontend/nginx/tls.conf.example, README "HTTPS").
HTTPS=false
# HSTS with "preload" (hstspreload.org): only once the domain and all its subdomains are HTTPS for good.
# HSTS_PRELOAD=true

# Database passwords: the superuser (used only by the one-off "migrate" service to set up the two roles
# below; it takes effect when the database volume is first created), the owner role that runs the
# migrations, and the app role Django runs as (it may only read and write rows). The local values are
# refused on a real deployment: set long random ones (letters, digits, - and _), for example
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing POSTGRES_OWNER_PASSWORD or POSTGRES_APP_PASSWORD later rotates them on the next start.
POSTGRES_PASSWORD=iga-local-only
# POSTGRES_OWNER_PASSWORD=iga-local-owner
# POSTGRES_APP_PASSWORD=iga-local-app
# DJANGO_ALLOWED_HOSTS=iga.example.rw
# CSRF_TRUSTED_ORIGINS=https://iga.example.rw
# Other sites that may call the API from the browser: none (nginx serves app and API from one origin). List
# https:// origins only if the app is served from another origin; wildcards are refused.
# CORS_ALLOWED_ORIGINS=

# Client addresses (rate limits, sign-in lockouts and the audit log depend on them). nginx decides who the
# client is and tells Django, which trusts that one hop (TRUSTED_PROXY_COUNT=1; keep it at 1 with the
# bundled nginx). By default nobody may tell nginx otherwise: the client is whoever connects, and made-up
# X-Forwarded-For or CF-Connecting-IP headers are ignored. Behind Cloudflare (docs/CLOUDFLARE.md):
# NGINX_TRUSTED_PROXIES=cloudflare
# NGINX_ONLY_FROM_TRUSTED_PROXIES=true
# Behind your own load balancer: its addresses or ranges, and the header it puts the client's address in.
# NGINX_TRUSTED_PROXIES=10.0.0.0/8
# NGINX_REAL_IP_HEADER=X-Forwarded-For
# TRUSTED_PROXY_COUNT=1

# nginx's rate limits per client address (429 with a JSON answer when exceeded). A whole school often shares
# one public address, so they are generous; raise them for a big school. Django adds its own limits per
# account and per signed-in user (THROTTLE_* below).
# Sign-in, sign-up, password reset, 2FA, step-up and password changes, and the Django admin:
# NGINX_RATE_AUTH=30r/m
# NGINX_BURST_AUTH=40
# Santa's answers, C++/Java runs and payments:
# NGINX_RATE_COSTLY=60r/m
# NGINX_BURST_COSTLY=30
# Every other API request:
# NGINX_RATE_API=30r/s
# NGINX_BURST_API=300
# Requests in progress at once per address, and Santa answers streaming at once per address:
# NGINX_CONN_PER_IP=200
# NGINX_CONN_PER_IP_TUTOR=20
# Slow clients are dropped: the request line and headers must arrive within NGINX_CLIENT_HEADER_TIMEOUT; a body
# or an answer may stall at most this long between two reads; idle keep-alive connections close after this.
# NGINX_CLIENT_HEADER_TIMEOUT=10s
# NGINX_CLIENT_BODY_TIMEOUT=15s
# NGINX_SEND_TIMEOUT=30s
# NGINX_KEEPALIVE_TIMEOUT=20s
# The app's Content-Security-Policy: the default (frontend/nginx/defaults.envsh) allows only the app's own scripts,
# GeoGebra's loader and the PhET/GeoGebra frames. Replace it only to add a host, keeping the rest.
# NGINX_CSP=
# Largest request body: API requests (JSON), and the upload routes (resources, the Django admin). A bigger one
# is refused with a JSON 413 before it reaches Django (which has its own limits, DATA_UPLOAD_MAX_MEMORY_SIZE).
# NGINX_MAX_BODY_API=2m
# NGINX_MAX_BODY_UPLOAD=25m

# Content managers' Django admin, off by default. To switch it on, set both: it then lives at
# /django-admin/<DJANGO_ADMIN_PATH>/ (a long random value: letters, digits, - and _, at least 16), and
# staff need 2FA to sign in. Platform admins find the link in the app's admin area.
# DJANGO_ADMIN_ENABLED=true
# DJANGO_ADMIN_PATH=
# DJANGO_ADMIN_SESSION_HOURS=8
# The app's session cookie is SameSite=Strict (the app and its API share one site behind nginx).
# REFRESH_COOKIE_SAMESITE=Strict

# Argon2id password hashing costs (Django's defaults). Each login briefly uses ARGON2_MEMORY_COST_KIB of
# memory; lower it on a small server. Changes apply to each password at its owner's next login.
# ARGON2_TIME_COST=2
# ARGON2_MEMORY_COST_KIB=102400
# ARGON2_PARALLELISM=8

# Sign-in protection. Failures in a row lock sign-in for a while (doubling each time that day): 5 for
# one account from one IP, 20 for one account from anywhere, 100 from one IP (a school shares one).
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_ACCOUNT_THRESHOLD=20
# LOGIN_LOCKOUT_IP_THRESHOLD=100
# LOGIN_LOCKOUT_BASE_SECONDS=60
# LOGIN_LOCKOUT_MAX_SECONDS=3600
# Rate limits in Django (nginx adds per-IP limits in front, NGINX_RATE_* above). Every request counts
# against "anon" (per IP, not signed in) or "user" (per signed-in user), plus the endpoint's own limit:
# THROTTLE_ANON=600/min
# THROTTLE_USER=600/min
# New accounts per IP, reset emails per account and per IP, refreshes per account.
# THROTTLE_REGISTER=100/hour
# THROTTLE_PASSWORD_RESET=5/hour
# THROTTLE_PASSWORD_RESET_IP=30/hour
# THROTTLE_REFRESH_USER=60/min
# Security events are JSON lines on the backend's output (logger "iga.security") and in Admin -> Audit.
# SECURITY_LOG_LEVEL=INFO
# "Forgot your password?" emails a link that works once, for this many seconds. It needs the email
# settings below (EMAIL_BACKEND=...smtp...); with the console backend the link only appears in the logs.
# PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Temporary passwords teachers hand out stop working after this many days.
# TEMPORARY_PASSWORD_DAYS=14
# "This email is already used" answers per hour (per IP for sign-up, per account otherwise).
# EMAIL_IN_USE_LIMIT=10

# --- Santa, Iga's own AI tutor ----------------------------------------------
# Santa's model runs on this server (the "santa" service), so no question ever leaves it. The first start
# downloads the model once (about 4.5 GB); 16 GB of RAM is recommended. See "Santa" in README.md.
# The service is optional and starts only with its Compose profile: uncomment this line (or run
# `docker compose --profile santa up -d`). Without it the app starts as usual, says Santa's model is not
# installed, and Santa answers from the lessons.
# COMPOSE_PROFILES=santa
# A random secret shared by Django and the model server, for a real deployment:
# SANTA_API_KEY=
# The model, from Hugging Face. For an 8 GB server use the smaller one, with a lower memory limit:
# SANTA_MODEL=google/gemma-4-E2B-it-qat-q4_0-gguf:Q4_0
# SANTA_MEMORY_LIMIT=5g
# CPU threads for the model: the number of physical cores.
# SANTA_THREADS=4
# After the first download: never go online again, use only the model already downloaded.
# SANTA_OFFLINE=true
# Only for gated or private models: a Hugging Face token.
# HF_TOKEN=
# Run without the model (Santa then answers from the lessons only): uncomment with an empty value.
# SANTA_URL=
# Longest answer in tokens, creativity (0-1), and the most seconds one answer may take.
# SANTA_MAX_TOKENS=600
# SANTA_TEMPERATURE=0.6
# SANTA_TIMEOUT_SECONDS=150

# C++ and Java in the code playground run on the bundled code runner (coderunner/). Set a random secret
# for a real deployment; uncomment CODE_RUNNER_URL (empty value) to switch C++ and Java off.
# CODE_RUNNER_TOKEN=
# CODE_RUNNER_SLOTS=4
# CODE_RUNNER_URL=

# --- School subscriptions -------------------------------------------------
# Price per school per month. MTN MoMo and Airtel Money only work in francs, so set an RWF price
# (whole francs) to offer them; with USD only, schools can pay by card.
# SUBSCRIPTION_PRICE_USD=200
# SUBSCRIPTION_PRICE_RWF=280000
# Online payments through Flutterwave (cards, MTN MoMo and Airtel Money in Rwanda).
# Without it, the Iga team records bank transfers in Admin → Schools.
# BILLING_PROVIDER=flutterwave
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# FLUTTERWAVE_WEBHOOK_HASH=a-long-random-string   (same value as in the Flutterwave dashboard)
# Webhook URL to set in the Flutterwave dashboard: https://<your-domain>/api/billing/webhooks/flutterwave/
# and tick: JSON format, v3 webhooks, webhook retries, resend from the dashboard (docs/SUBSCRIPTIONS.md).
# CHECKOUT_SESSION_MINUTES=60                  (how long Flutterwave's payment page stays open)
# FRONTEND_URL=https://iga.example.rw          (where Flutterwave sends people back after paying)
# A fake checkout for demos only. Never enable it on a real server: with HTTPS on, the backend refuses
# to start with it, or with a Flutterwave test key (FLWSECK_TEST-...), unless this is a staging server
# that takes test payments on purpose and sets BILLING_ALLOW_TEST_PAYMENTS=true.
# BILLING_DEV_MODE=true
# BILLING_ALLOW_TEST_PAYMENTS=false
# The money ledger chains every payment, refund and correction by hash (verify it with
# `python manage.py verify_ledger`). Optional key: with it, someone who can write to the database
# can't rebuild the chain without it. Generate a long random value, keep it out of the database
# backups' location, and never change it once set (older entries need it to verify).
# LEDGER_HMAC_KEY=a-long-random-string

# --- Uploads (teachers' resources and past papers) ----------------------------
# Every file is checked by its contents and images are re-encoded (apps/core/uploads.py). Largest file
# (nginx accepts 25 MB per request), largest image, and the most pixels an image may have (all frames
# of an animation together).
# UPLOAD_MAX_MB=20
# UPLOAD_IMAGE_MAX_MB=5
# UPLOAD_IMAGE_MAX_PIXELS=50000000
# Longest text (a lesson, a shared note, a question) people may save; shorter fields keep their own limits.
# TEXT_MAX_CHARS=100000

# --- Email (receipts, subscription reminders and password reset links) ------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=Iga <no-reply@iga.rw>
